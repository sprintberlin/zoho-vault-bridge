# Zoho Vault Bridge Environment Variables
# Copy to .env and fill in values from your Zoho API Console Self Client

# Zoho Data Center: eu (default for Europe), us, in, au, com.cn, ca
ZOHO_VAULT_DC=eu

# Self Client OAuth 2.0 Credentials (from https://api-console.zoho.eu or accounts.zoho.com)
ZOHO_VAULT_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_VAULT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_VAULT_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Master Passphrase (required for zero-knowledge AES-256 decryption/encryption of passwords)
# If omitted, metadata and raw encrypted payloads can be accessed, but not plain passwords.
ZOHO_VAULT_PASSPHRASE=YourMasterPassphraseHere
